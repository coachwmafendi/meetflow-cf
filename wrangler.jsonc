{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meetflow",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meetflow-db",
      "database_id": "9cbf498e-2813-42ab-a98a-8491107d5d3b",
      "migrations_dir": "migrations"
    }
  ],
  // Abuse guard for the unauthenticated booking endpoint. Counters are per-colo,
  // not global — enough to stop hammering, not a billing control.
  "ratelimits": [
    {
      "name": "BOOK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
