{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meetflow",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meetflow-db",
      "database_id": "9cbf498e-2813-42ab-a98a-8491107d5d3b",
      "migrations_dir": "migrations"
    }
  ],
  // Abuse guard for the unauthenticated booking endpoint. A Durable Object is used
  // instead of the Workers Rate Limiting binding: that binding is accepted and shown
  // in `wrangler deploy` output, but never rejects on this account (verified in
  // production at limit=2/60s with 8 requests from a single IP).
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  // Host avatars and event cover images. Objects are served back through the
  // Worker rather than a public bucket URL, so we control the Content-Type and
  // caching headers.
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "meetflow-avatars" },
    { "binding": "EVENT_IMAGES", "bucket_name": "meetflow-event-images" }
  ],
  // Email is sent off the request path: a booking must never fail or hang because
  // Resend is slow. Queues gives durable retries and a dead-letter queue.
  "queues": {
    "producers": [{ "queue": "meetflow-emails", "binding": "EMAIL_QUEUE" }],
    "consumers": [
      {
        "queue": "meetflow-emails",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "meetflow-emails-dlq"
      }
    ]
  },
  // Hourly sweep that queues 24-hour reminders.
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "EMAIL_FROM": "MeetFlow <bookings@mailr.my>",
    "APP_URL": "https://meetflow.wmafendi.workers.dev"
  },
  "observability": { "enabled": true }
}
