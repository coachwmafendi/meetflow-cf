{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meetflow",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meetflow-db",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
