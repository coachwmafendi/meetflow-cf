{
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "overrides": [
    {
      "comment": "wrangler.jsonc is deploy-critical; keep it parseable by strict JSON readers too.",
      "files": "*.jsonc",
      "options": { "trailingComma": "none" }
    }
  ]
}
