{
  "name": "meetflow",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run css && wrangler dev",
    "css": "npm run fonts && tailwindcss -i ./src/styles/app.css -o ./public/app.css",
    "css:watch": "tailwindcss -i ./src/styles/app.css -o ./public/app.css --watch",
    "build": "npm run css",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply meetflow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meetflow-db --remote",
    "deploy": "npm run css && wrangler deploy",
    "fonts": "mkdir -p public/fonts && cp node_modules/@fontsource-variable/geist/files/geist-latin-wght-normal.woff2 node_modules/@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2 public/fonts/"
  },
  "dependencies": {
    "alpinejs": "^3.17.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.5.1",
    "dotted-map": "^3.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
